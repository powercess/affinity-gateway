AFFINITY_VERSION=0.1.2
AFFINITY_BIND=0.0.0.0
AFFINITY_API_PORT=18343
AFFINITY_CONSOLE_PORT=18342

# Generate independent random values. Do not reuse these placeholders.
SESSION_AFFINITY_SECRET=replace-with-at-least-32-random-bytes
NEW_API_SESSION_SECRET=replace-with-an-independent-random-secret
POSTGRES_PASSWORD=replace-with-a-random-database-password

# true deliberately exposes the console without authentication.
AFFINITY_TEST=false
AFFINITY_CONSOLE_PASSWORD=replace-with-at-least-32-random-bytes
