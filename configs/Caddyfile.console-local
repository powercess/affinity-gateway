{
    admin off
    auto_https off
    persist_config off
}

http://127.0.0.1:18241 {
    bind 127.0.0.1
    route /api/* {
        affinity_console AFFINITY_CONSOLE_PASSWORD SUPPLIER_CONFIG_FILE
    }
    route /v1/* {
        session_affinity {
            mode inbound
            secret_env SESSION_AFFINITY_SECRET
            observe_id local-inbound
        }
        # Local collection probe only, not an upstream model service.
        respond "collection probe" 200
    }
}

http://127.0.0.1:18239 {
    bind 127.0.0.1
    affinity_egress SUPPLIER_CONFIG_FILE SESSION_AFFINITY_SECRET
}
